# Load packages and libraries
library(AIscreenR)
library(writexl)
library(dplyr)
library(synthesisr)
library(tibble)
library(revtools)
library(flextable)
library(tinytex)
library(tidyr)
library(ggplot2)
library(gt)
library(webshot2)
library(packrat)
library(rsconnect)
library(chromote)
library(readxl)
library(future)
devtools::install_github("MikkelVembye/AIscreenR") #most recent pakcage updates
#Load data of the project
load(".RData")
View(FN_helvetesild3)
View(helvetesild_screening_3)
View(helvetesild_3_analysis)
View(FN_helvetesild3)
View(confusion_helvetesild3_values)
View(confusion_helvetesild3_excel)
